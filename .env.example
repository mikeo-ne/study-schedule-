# ===========================================================================
# polymkt-alpha configuration. Copy to `.env` and fill in for LIVE data/trading.
# With NO .env the bot runs fully in SIMULATION + PAPER mode (safe default).
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
PORT=3000

# Where market/sentiment data comes from:
#   sim  -> built-in deterministic market simulator (no network needed)
#   live -> real Polymarket Gamma/CLOB APIs (requires network egress)
DATA_SOURCE=sim

# Trading mode:
#   paper -> simulated fills against the order book, no real money (DEFAULT)
#   live  -> submits real orders to Polymarket CLOB (requires keys below)
TRADE_MODE=paper

# --- Research loop ---------------------------------------------------------
SCAN_INTERVAL_MS=600000        # 10 minutes between full scans
MARKET_UNIVERSE=2000           # how many markets to track
EDGE_THRESHOLD=0.08            # min mispricing (8%) to consider a trade
MIN_LIQUIDITY_USD=5000         # skip markets thinner than this
BANKROLL_USD=10000             # starting paper bankroll
KELLY_FRACTION=0.25            # fractional Kelly multiplier on full Kelly

# Risk rail: no single bet may exceed this fraction of CURRENT equity, so one
# bad call can't wipe the bankroll. This is the primary sizing cap.
MAX_POSITION_PCT=0.06          # 6% of equity per bet, max
# Optional absolute dollar ceiling on top of the % cap (0 = disabled).
MAX_POSITION_USD=0

# --- Portfolio risk controls ----------------------------------------------
MAX_PORTFOLIO_EXPOSURE_PCT=0.60  # never deploy past 60% of equity at once
TAKE_PROFIT_PCT=0.40             # close a winner up +40% on cost
STOP_LOSS_PCT=0.25               # close a loser down -25% on cost
EXIT_EDGE_FLOOR=0.02             # close when the modeled edge falls below 2%
RESOLVE_THRESHOLD=0.97           # treat a position at >=97c as resolved, take it

# --- Polymarket (only needed for DATA_SOURCE=live / TRADE_MODE=live) --------
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# CLOB API credentials (create via Polymarket). Required ONLY for live trading.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# Wallet private key for signing orders. KEEP SECRET. Live trading only.
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=

# --- X / Twitter sentiment (optional) --------------------------------------
# If empty, sentiment is derived from the simulator (sim) or skipped (live).
X_BEARER_TOKEN=
